# --- Supabase (Vercel Marketplace integration, or a dedicated project connected manually) ---
# Get these from your Supabase project: Settings -> API (URL, publishable key, secret key)
# and Settings -> Database -> Connection string (direct or session pooler, URI tab).
#
# Note: the spec originally referred to these as NEXT_PUBLIC_SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY. Supabase's 2025+ API key system renamed them; the names
# below are what the app's code actually reads. Functionally equivalent:
#   publishable = anon-equivalent (safe in the browser, RLS still applies)
#   secret      = service-role-equivalent (server-only, bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct (non-pooled) connection string, used by `supabase db push` for migrations.
# If your network can't resolve the IPv6-only direct host (db.<ref>.supabase.co),
# use the Session Pooler string instead (Settings -> Database -> Connection string).
POSTGRES_URL_NON_POOLING=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM provider (Phase 1) ---
# TEMPORARY: using Groq (free tier) instead of Anthropic until ANTHROPIC_API_KEY has
# billing set up. Only lib/agent/model.ts knows about this — swap it back to
# @anthropic-ai/sdk (claude-haiku-4-5-20251001, per the spec) there when ready, and
# ANTHROPIC_API_KEY replaces GROQ_API_KEY below. Get a Groq key from https://console.groq.com
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (Phase 1) ---
# Get from https://dash.voyageai.com — free tier, unaffected by the Groq swap above.
VOYAGE_API_KEY=

# --- Upstash Redis rate limiting (Phase 1) ---
# Provisioned via Vercel Marketplace (Upstash for Redis). Note: that integration
# names these KV_REST_API_URL / KV_REST_API_TOKEN, not UPSTASH_REDIS_REST_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Resend email (Phase 2) ---
RESEND_API_KEY=

# --- Encryption for stored WhatsApp access tokens (Phase 3) ---
# Base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- WhatsApp / Meta webhook (Phase 3) ---
# META_APP_SECRET: from Meta's app dashboard (Settings -> Basic -> App Secret).
#   Verifies incoming webhook requests are genuinely from Meta.
# WHATSAPP_VERIFY_TOKEN: a value YOU invent (not issued by Meta) — enter the same
#   string here and in Meta's webhook config UI during the one-time verification handshake.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
